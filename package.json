{
  "name": "colosseum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-colosseum",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-colosseum \"vitest run tests\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
