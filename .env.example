# local dev runs on the Firebase emulators with a fake "demo-" project,
# so none of these need to be real
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# for a real deploy, set this to the app's own domain (the one people open), not the default
# firebaseapp.com one. phones sign in with a redirect, and browsers block it when the auth domain
# is a different site from the app. next.config.ts passes /__/auth through so this works.
# see "Deploying" in the README
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-colosseum.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-colosseum
NEXT_PUBLIC_USE_EMULATORS=true
