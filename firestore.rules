rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // the arenas you're in, from your own player record (only Cloud Functions change it)
    function inArena(arenaId) {
      return signedIn() && arenaId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.arenaIds;
    }

    // anyone signed in can see players (name, photo, glory, record).
    // nobody writes them from the app, only Cloud Functions do
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;

      // which result screens you've already seen, so each one only shows once.
      // only you can read or add to your own list, and it doesn't touch glory or tokens
      match /seen/{callId} {
        allow read, create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // you can see arenas you're in. making and joining them goes through Cloud Functions
    match /arenas/{arenaId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // calls are only visible to members of the arena they were posted in.
    // made and changed only by Cloud Functions
    match /predictions/{predictionId} {
      allow read: if inArena(resource.data.arenaId);
      allow write: if false;

      // who picked which side, visible to the same people as the call.
      // written only by Cloud Functions (takeSide, createCall)
      match /positions/{uid} {
        allow read: if inArena(get(/databases/$(database)/documents/predictions/$(predictionId)).data.arenaId);
        allow write: if false;
      }

      // ---------- trash talk ----------
      // the one thing the app writes straight to Firestore, since it never touches glory or tokens.
      // only arena members, only as yourself, and not on a call the subject took down (its text is wiped)

      function theCall() {
        return get(/databases/$(database)/documents/predictions/$(predictionId)).data;
      }

      function canTalk() {
        return inArena(theCall().arenaId) && theCall().text != "";
      }

      // one reaction per person per call, saved under your own uid. pick, switch, or take it back
      match /reactions/{uid} {
        allow read: if inArena(theCall().arenaId);
        allow create, update: if canTalk()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["uid", "type", "createdAt"])
          && request.resource.data.uid == uid
          && request.resource.data.type in ["noshot", "lockit", "cap"]
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // short comments. you can edit or delete your own, nobody else's
      match /comments/{commentId} {
        allow read: if inArena(theCall().arenaId);
        allow create: if canTalk()
          && request.resource.data.keys().hasOnly(["uid", "text", "createdAt", "edited"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.edited == false;
        allow update: if canTalk()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "edited"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.edited == true;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // lets the app find all of your own positions across every call at once
    match /{path=**}/positions/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // anything not matched above is blocked by default
  }
}
