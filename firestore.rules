rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // anyone signed in can see players (for the leaderboard).
    // nobody writes them from the app, only Cloud Functions do
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // no groups yet, so anyone signed in can see every call.
    // calls are made and changed only by Cloud Functions
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // who picked which side. everyone signed in can see them (names and sides show
    // before the deadline). written only by the takeSide Cloud Function.
    // the {path=**} part lets the app search positions across every call at once
    match /{path=**}/positions/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // anything not matched above is blocked by default
  }
}
